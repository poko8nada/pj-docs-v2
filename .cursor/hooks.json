{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/inject-context.mjs",
        "failClosed": false
      }
    ],
    "sessionEnd": [
      {
        "command": "node .cursor/hooks/session-end.mjs",
        "failClosed": false
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/track-phase.mjs",
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/gate-code.mjs",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/restrict-root.mjs",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/track-implement.mjs",
        "matcher": "Read",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/gate-code.mjs",
        "matcher": "Write|StrReplace|Delete|EditNotebook",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/restrict-root.mjs",
        "matcher": "Write|StrReplace|Read|Delete|EditNotebook",
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/track-implement.mjs",
        "matcher": "Read",
        "failClosed": false
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/track-implement.mjs",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/restrict-root.mjs",
        "failClosed": true
      }
    ]
  }
}
