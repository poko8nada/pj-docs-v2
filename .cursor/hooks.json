{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/inject-context.mjs",
        "failClosed": false
      }
    ],
    "sessionEnd": [
      {
        "command": "node .cursor/hooks/session-end.mjs",
        "failClosed": false
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/track.mjs",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/check.mjs",
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/gate.mjs",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/track.mjs",
        "failClosed": false
      }
    ],
    "afterShellExecution": [
      {
        "command": "node .cursor/hooks/track.mjs",
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/track.mjs",
        "matcher": "Read|ReadFile",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/track.mjs",
        "matcher": "Task",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/gate.mjs",
        "matcher": "Write|StrReplace|Delete|EditNotebook",
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/track.mjs",
        "matcher": "Read|ReadFile",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/track.mjs",
        "matcher": "Write|StrReplace|Delete|EditNotebook",
        "failClosed": false
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/track.mjs",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/gate.mjs",
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/check.mjs",
        "failClosed": false,
        "timeout": 120
      }
    ]
  }
}
