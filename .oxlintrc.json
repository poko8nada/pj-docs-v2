{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "allow",
    "no-undef": "error",
    "no-unreachable": "error",
    "no-unreachable-loop": "error",
    "no-unused-vars": "error",
    "no-explicit-any": "error",
    "unicorn/no-array-for-each": "warn",
    "unicorn/no-empty-file": "warn",
    "import/no-default-export": "error",
    "import/no-duplicates": "error",
    "react/react-in-jsx-scope": "allow",
    "react/iframe-missing-sandbox": "allow",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "hono"]
      }
    ]
  },
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "overrides": [
    {
      "files": ["**/*.config.{js,ts}", "vite.config.ts"],
      "rules": { "import/no-default-export": "off" }
    },
    {
      "files": ["**/pages/**/*.tsx", "**/app/**/page.tsx", "**/app/**/layout.tsx"],
      "rules": { "import/no-default-export": "off" }
    },
    {
      "files": ["src/index.tsx", "src/server.tsx"],
      "rules": { "import/no-default-export": "off" }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", ".next", "coverage", "*.md"]
}
